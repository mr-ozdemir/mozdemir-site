---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../i18n/ui';
import { pagePath } from '../i18n/routes';

const tr = useTranslations('tr');
const en = useTranslations('en');
---

<BaseLayout lang="tr" path="/404.html" title={tr('notfound.title')} description={tr('notfound.text')} noindex hasAlternate={false}>
  <div class="container page">
    <h1>{tr('notfound.title')}</h1>
    <p class="lead">{tr('notfound.text')}</p>
    <p class="lead" lang="en">{en('notfound.text')}</p>
    <p class="actions">
      <a href={pagePath('tr', 'home')}>{tr('nav.home')}</a> · <a href={pagePath('en', 'home')} lang="en">Home (English)</a>
    </p>
  </div>
</BaseLayout>

<style>
  .lead {
    margin-top: 12px;
  }

  .actions {
    margin-top: 24px;
  }
</style>
