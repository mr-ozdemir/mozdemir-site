---
import Icon from './Icon.astro';
import { useTranslations, languages, type Lang } from '../i18n/ui';
import { pagePath, alternatePath, otherLang, type PageKey } from '../i18n/routes';
import { profile } from '../data/site';

interface Props {
  lang: Lang;
  current?: PageKey;
  /** Bu sayfanın diğer dildeki karşılığı. */
  altPath?: string;
}

const { lang, current, altPath } = Astro.props;
const t = useTranslations(lang);
const other = otherLang(lang);
const switchHref = altPath ?? alternatePath(Astro.url.pathname, other);

const items: { key: PageKey; label: string }[] = [
  { key: 'projects', label: t('nav.projects') },
  { key: 'publications', label: t('nav.publications') },
  { key: 'cv', label: t('nav.cv') },
  { key: 'about', label: t('nav.about') },
];
---

<header class="site-header container">
  <a class="brand" href={pagePath(lang, 'home')}>{profile.name}</a>
  <nav aria-label={t('nav.primary')}>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={pagePath(lang, item.key)} aria-current={current === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="tools">
    <a href={switchHref} hreflang={other} lang={other}>
      <span class="visually-hidden">{t('lang.switch')}: </span>{other.toUpperCase()}
    </a>
    <button type="button" aria-label={t('theme.toggle')} data-theme-toggle>
      <Icon name="moon" class="i-moon" />
      <Icon name="sun" class="i-sun" />
    </button>
  </div>
</header>

<script>
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding-top: 24px;
    padding-bottom: 8px;
  }

  .brand {
    margin-right: auto;
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 0;
  }

  nav a,
  .tools a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9375rem;
  }

  nav a:hover,
  .tools a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 6px;
    text-decoration-color: var(--rule);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    border-radius: 6px;
  }

  button:hover {
    color: var(--text);
  }

  button :global(svg) {
    width: 16px;
    height: 16px;
  }

  button :global(.i-sun),
  :global([data-theme='dark']) button :global(.i-moon) {
    display: none;
  }

  :global([data-theme='dark']) button :global(.i-sun) {
    display: block;
  }

  /* Mobilde menü ikinci satıra iner; gizli menü yok. */
  @media (max-width: 600px) {
    nav {
      order: 3;
      width: 100%;
    }

    nav ul {
      gap: 18px;
    }
  }
</style>
