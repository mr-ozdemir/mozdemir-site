---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  pub: CollectionEntry<'publications'>;
}

const { lang, pub } = Astro.props;
const t = useTranslations(lang);
const { data } = pub;
const meta = [data.venue?.[lang], data.year, t(`pub.status.${data.status}`)].filter(Boolean).join(' · ');
const authors = data.authors.map((a) => a.name).join(', ');
---

<li id={pub.id}>
  <p class="item-title" lang={data.title[lang] === data.title.en ? 'en' : undefined}>{data.title[lang]}</p>
  {authors && <p class="item-meta">{authors}</p>}
  <p class="item-meta">{meta}</p>
  {
    data.links.length > 0 && (
      <p class="item-meta">
        {data.links.map((l, i) => (
          <>
            {i > 0 && ' · '}
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          </>
        ))}
      </p>
    )
  }
</li>
