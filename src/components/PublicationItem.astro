---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { projectPath } from '../i18n/routes';

interface Props {
  lang: Lang;
  pub: CollectionEntry<'publications'>;
  projectTitle?: string;
  headingLevel?: 'h2' | 'h3';
}

const { lang, pub, projectTitle, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const { data } = pub;
const Heading = headingLevel;
const statusClass =
  data.status === 'published' || data.status === 'revision-submitted' ? 'badge-research' : '';
---

<li class="pub" id={pub.id}>
  <div class="pub-status">
    <span class={`badge ${statusClass}`}>{t(`pub.status.${data.status}`)}</span>
  </div>
  <div>
    <Heading class="pub-title" lang={data.title[lang] === data.title.en ? 'en' : undefined}>
      {data.title[lang]}
    </Heading>
    {
      data.authors.length > 0 && (
        <p class="pub-authors">
          {data.authors.map((a, i) => (
            <>
              {a.self ? <strong>{a.name}</strong> : a.name}
              {i < data.authors.length - 1 ? ', ' : ''}
            </>
          ))}
        </p>
      )
    }
    {
      (data.venue || data.year) && (
        <p class="pub-authors">{[data.venue?.[lang], data.year].filter(Boolean).join(' · ')}</p>
      )
    }
    <p class="pub-tldr">{data.tldr[lang]}</p>
    {
      (data.links.length > 0 || (data.project && projectTitle)) && (
        <p class="pub-actions">
          {data.links.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))}
          {data.project && projectTitle && (
            <a href={projectPath(lang, data.project)}>
              {t('pub.related')}: {projectTitle}
            </a>
          )}
        </p>
      )
    }
  </div>
</li>
