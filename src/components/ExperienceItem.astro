---
import { useTranslations, type Lang } from '../i18n/ui';
import type { Experience } from '../data/site';

interface Props {
  lang: Lang;
  item: Experience;
  compact?: boolean;
}

const { lang, item, compact = false } = Astro.props;
const t = useTranslations(lang);
const end = item.end ?? t('cv.present');
const points = compact ? item.points[lang].slice(0, 1) : item.points[lang];
---

<li class="xp">
  <p class="xp-date meta">{item.start} — {end}</p>
  <div>
    <h3 class="xp-role">{item.role[lang]}</h3>
    <p class="xp-org">{item.org[lang]}</p>
    <ul class="xp-points">
      {points.map((p) => <li>{p}</li>)}
    </ul>
  </div>
</li>
