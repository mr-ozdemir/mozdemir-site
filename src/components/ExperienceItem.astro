---
import { useTranslations, type Lang } from '../i18n/ui';
import type { Experience } from '../data/site';

interface Props {
  lang: Lang;
  item: Experience;
  /** Ana sayfada yalnızca başlık satırı gösterilir. */
  details?: boolean;
}

const { lang, item, details = false } = Astro.props;
const t = useTranslations(lang);
---

<li>
  <div class="item-head">
    <p class="item-title">{item.role[lang]}</p>
    <p class="item-date">{item.start} — {item.end ?? t('cv.present')}</p>
  </div>
  <p class="item-meta">{item.org[lang]}</p>
  {
    details && (
      <ul class="item-text">
        {item.points[lang].map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    )
  }
</li>

<style>
  ul {
    padding-left: 1.1em;
  }
</style>
