---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import type { Lang } from '../i18n/ui';
import { projectPath } from '../i18n/routes';
import type { Project } from '../lib/content';

interface Props {
  lang: Lang;
  project: Project;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { lang, project, headingLevel = 'h3', eager = false } = Astro.props;
const { data } = project;
const Heading = headingLevel;
---

<article class="card" data-category={data.category}>
  <div class="card-media">
    <Image
      src={data.cover}
      alt=""
      widths={[480, 720, 960]}
      sizes="(min-width: 1120px) 520px, (min-width: 720px) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
      decoding="async"
    />
  </div>
  <div class="card-body">
    <div class="card-meta">
      <StatusBadge lang={lang} status={data.status} />
      <span class="card-context">{data.context}</span>
    </div>
    <Heading class="card-title">
      <a class="card-link" href={projectPath(lang, project.slug)}>{data.title}</a>
    </Heading>
    <p class="card-summary">{data.summary}</p>
    {
      data.outcome && (
        <p class="card-outcome">
          <Icon name="arrow-right" />
          <span>{data.outcome}</span>
        </p>
      )
    }
    <div class="card-footer">
      <ul class="tags">
        {data.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    </div>
  </div>
</article>
