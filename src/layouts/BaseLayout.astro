---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { alternatePath, otherLang, pagePath, type PageKey } from '../i18n/routes';
import { profile } from '../data/site';
import profilePhoto from '../assets/images/profile.jpeg';

interface Props {
  lang: Lang;
  /** Sitedeki yol, ör. "/about.html" veya "/en/". Canonical ve hreflang bundan üretilir. */
  path: string;
  title: string;
  description: string;
  current?: PageKey;
  image?: ImageMetadata;
  imageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** Diğer dilde karşılığı yoksa false. */
  hasAlternate?: boolean;
}

const {
  lang,
  path,
  title,
  description,
  current,
  image,
  imageAlt,
  jsonLd,
  type = 'website',
  noindex = false,
  hasAlternate = true,
} = Astro.props;

const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://mozdemir.com');
const canonical = new URL(path, site).href;
const altPathname = alternatePath(path, otherLang(lang));
const trHref = new URL(lang === 'tr' ? path : altPathname, site).href;
const enHref = new URL(lang === 'en' ? path : altPathname, site).href;

const og = await getImage({
  src: image ?? profilePhoto,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: image ? 'center' : 'top',
  format: 'jpg',
  quality: 80,
});
const ogUrl = new URL(og.src, site).href;
const fullTitle = title === profile.name ? `${profile.name} — ${profile.role[lang]}` : `${title} — ${profile.name}`;
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang="tr" href={trHref} />
          <link rel="alternate" hreflang="en" href={enHref} />
          <link rel="alternate" hreflang="x-default" href={trHref} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? profile.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script is:inline>
      // Tema ilk çizimden önce uygulanır (yanıp sönme olmaz). Tercih yoksa sistem ayarı (R38).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var stored = null;
        try {
          stored = localStorage.getItem('theme');
        } catch (e) {}
        var dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        d.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>

    <slot name="head" />

    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip')}</a>
    <Header lang={lang} current={current} altPath={hasAlternate ? altPathname : pagePath(otherLang(lang), 'home')} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    padding: 8px 14px;
    border-radius: 6px;
    background: var(--text);
    color: var(--bg);
    text-decoration: none;
  }

  .skip-link:focus {
    top: 12px;
  }

  main:focus {
    outline: none;
  }
</style>
