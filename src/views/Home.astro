---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import PublicationItem from '../components/PublicationItem.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { pagePath } from '../i18n/routes';
import { profile, experience } from '../data/site';
import { getProjects, getPublications } from '../lib/content';
import profilePhoto from '../assets/images/profile.jpeg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const featured = (await getProjects(lang)).filter((p) => p.data.featured);
const pubs = (await getPublications()).filter((p) => p.data.selected).slice(0, 2);

const description =
  lang === 'tr'
    ? 'Muhammet Özdemir — yapay zekâ mühendisi ve araştırmacısı. AutoML araştırması; üretimde çalışan bilgisayarlı görü ve kimlik doğrulama sistemleri.'
    : 'Muhammet Özdemir — AI engineer and researcher. AutoML research; production computer-vision and identity-verification systems.';

const site = 'https://mozdemir.com';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site}/#website`, name: profile.name, url: `${site}/` },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${site}/#person`,
    name: profile.name,
    alternateName: profile.alternateName,
    jobTitle: profile.role[lang],
    url: `${site}/`,
    email: `mailto:${profile.email}`,
    alumniOf: { '@type': 'CollegeOrUniversity', name: lang === 'tr' ? 'Erciyes Üniversitesi' : 'Erciyes University' },
    knowsAbout: ['AutoML', 'Computer Vision', 'Machine Learning', 'Deep Learning', 'MLOps'],
    sameAs: [profile.github, profile.linkedin],
  },
];
---

<BaseLayout lang={lang} path={pagePath(lang, 'home')} title={profile.name} description={description} jsonLd={jsonLd}>
  <div class="container page">
    <section class="intro">
      <Image class="avatar" src={profilePhoto} alt="" width={72} height={72} densities={[1, 2]} fit="cover" position="top" loading="eager" />
      <h1>{profile.name}</h1>
      <p class="role">{profile.role[lang]}</p>
      <p class="tagline">{profile.tagline[lang]}</p>
      <p class="links">
        <a href={`mailto:${profile.email}`}>{lang === 'tr' ? 'E-posta' : 'Email'}</a> ·
        <a href={profile.cvPdf} download="Muhammet_Ozdemir_CV.pdf">CV (PDF)</a> ·
        <a href={profile.github} target="_blank" rel="me noopener">GitHub</a> ·
        <a href={profile.linkedin} target="_blank" rel="me noopener">LinkedIn</a>
      </p>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('home.projects')}</h2>
        <a class="small" href={pagePath(lang, 'projects')}>{t('home.projects.all')} →</a>
      </div>
      <ul class="projects">
        {featured.map((p) => <ProjectRow lang={lang} project={p} />)}
      </ul>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('home.publications')}</h2>
        <a class="small" href={pagePath(lang, 'publications')}>{t('home.publications.all')} →</a>
      </div>
      <ul class="list">
        {pubs.map((p) => <PublicationItem lang={lang} pub={p} />)}
      </ul>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>{t('home.experience')}</h2>
        <a class="small" href={pagePath(lang, 'cv')}>{t('home.experience.all')} →</a>
      </div>
      <ul class="list">
        {experience.map((x) => <ExperienceItem lang={lang} item={x} />)}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .intro {
    padding-top: 16px;
  }

  .intro :global(.avatar) {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 20px;
  }

  .role {
    margin-top: 4px;
    color: var(--muted);
  }

  .tagline {
    margin-top: 16px;
  }

  .links {
    margin-top: 16px;
    color: var(--muted);
  }
</style>
