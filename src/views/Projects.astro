---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { pagePath } from '../i18n/routes';
import { club } from '../data/site';
import { getProjects } from '../lib/content';
import clubCover from '../assets/images/club/club-cover.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = await getProjects(lang);

const description =
  lang === 'tr'
    ? 'Üretimde çalışan KYC ve kampüs AI sistemleri, meme kanseri teşhisi, Nahıl AutoML, filo optimizasyonu ve ROS şerit tespiti projeleri.'
    : 'Projects including production KYC and campus AI systems, breast-cancer diagnosis, Nahıl AutoML, fleet optimization and ROS lane detection.';
---

<BaseLayout lang={lang} path={pagePath(lang, 'projects')} title={t('projects.title')} description={description} current="projects">
  <div class="container page">
    <h1>{t('projects.title')}</h1>

    <ul class="projects section">
      {projects.map((p) => <ProjectRow lang={lang} project={p} />)}
    </ul>

    <section class="section">
      <h2>{t('projects.activities')}</h2>
      <ul class="projects">
        <li class="project-row">
          <Image src={clubCover} alt="" width={256} height={144} fit="cover" />
          <div>
            <a href={pagePath(lang, 'club')}>{t('club.title')}</a>
            <p>{club.summary[lang]}</p>
            <p>{lang === 'tr' ? 'Kurucu & Başkan · 03/2024 — Güncel' : 'Founder & President · 03/2024 — Present'}</p>
          </div>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
