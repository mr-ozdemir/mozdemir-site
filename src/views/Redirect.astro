---
// Kaldırılan eski URL'ler için kabuk sayfa. GitHub Pages 301 veremediği için
// meta refresh + canonical kullanılır; arama motorları hedef sayfayı esas alır.
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  to: string;
  title: string;
}

const { lang, to, title } = Astro.props;
const t = useTranslations(lang);
const target = new URL(to, Astro.site ?? 'https://mozdemir.com').href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
  </head>
  <body>
    <p>{t('redirect.text')} <a href={to}>{target}</a></p>
  </body>
</html>
