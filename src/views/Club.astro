---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { pagePath } from '../i18n/routes';
import { club } from '../data/site';
import k1 from '../assets/images/club/k1.png';
import k2 from '../assets/images/club/k2.png';
import k3 from '../assets/images/club/k3.png';
import k4 from '../assets/images/club/k4.png';
import cover from '../assets/images/club/club-cover.png';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const photos = [k1, k2, k3, k4];
const photoAlt = lang === 'tr' ? 'Kulüp etkinliği' : 'Club event';

const description =
  lang === 'tr'
    ? 'Erciyes Üniversitesi Yapay Zekâ Kulübü: 8 TÜBİTAK projesi, TÜSEB finalisti sağlık AI projesi, 20 kişilik çekirdek ekip, ödüller ve etkinlikler.'
    : 'Erciyes University AI Club: eight TÜBİTAK projects, a TÜSEB-finalist healthcare AI project, a 20-person core team, awards and events.';
---

<BaseLayout lang={lang} path={pagePath(lang, 'club')} title={t('club.title')} description={description} current="projects" image={cover} imageAlt={t('club.title')}>
  <div class="container page">
    <p class="back small"><a href={pagePath(lang, 'projects')}>← {t('nav.projects')}</a></p>
    <h1>{t('club.title')}</h1>
    <p class="lead">{lang === 'tr' ? 'Kurucu & Başkan · 03/2024 — Güncel' : 'Founder & President · 03/2024 — Present'}</p>

    <div class="prose intro">
      <p>{club.about[lang]}</p>
      <p>{club.summary[lang]}</p>
      <p>
        <a href={club.url} target="_blank" rel="noopener">{t('club.site')}</a> ·
        <a href={club.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </p>
    </div>

    <div class="photos">
      {photos.map((p, i) => <Image src={p} alt={`${photoAlt} ${i + 1}`} widths={[360, 720]} sizes="(min-width: 760px) 352px, 50vw" />)}
    </div>

    <section class="section">
      <h2>{t('club.awards')}</h2>
      <ul class="list">
        {
          club.awards[lang].map((a) => (
            <li>
              <p class="item-title">{a.name}</p>
              <p class="item-meta">{a.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>{t('club.timeline')}</h2>
      <ul class="list">
        {
          club.timeline[lang].map((item) => (
            <li>
              <p class="item-title">{item.title}</p>
              <p class="item-meta">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .back {
    margin-bottom: 24px;
  }

  .intro {
    margin-top: 24px;
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 32px;
  }

  .photos :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 6px;
  }
</style>
