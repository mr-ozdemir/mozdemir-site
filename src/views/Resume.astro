---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { pagePath } from '../i18n/routes';
import { profile, experience, education, certificates, awards, skills } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pdf = profile.cvPdfMeta;

const description =
  lang === 'tr'
    ? 'Muhammet Özdemir özgeçmişi: serbest AI mühendisliği (bankacılık, gemicilik), ERÜ Yapay Zekâ Araştırma Merkezi, Skechers Türkiye stajı, eğitim ve yetkinlikler.'
    : 'CV of Muhammet Özdemir: self-employed AI engineering (banking, shipping), ERÜ AI Research Center, Skechers Türkiye internship, education and skills.';
---

<BaseLayout lang={lang} path={pagePath(lang, 'cv')} title={t('cv.title')} description={description} current="cv" type="profile">
  <div class="container page">
    <h1>{t('cv.title')}</h1>
    <p class="lead">
      <a href={profile.cvPdf} download="Muhammet_Ozdemir_CV.pdf">{t('cv.download')}</a>
      <span class="small"> ({pdf.sizeKb} KB)</span>
    </p>

    <section class="section">
      <h2>{t('cv.experience')}</h2>
      <ul class="list">
        {experience.map((x) => <ExperienceItem lang={lang} item={x} details />)}
      </ul>
    </section>

    <section class="section">
      <h2>{t('cv.education')}</h2>
      <ul class="list">
        {
          education.map((e) => (
            <li>
              <div class="item-head">
                <p class="item-title">{e.degree[lang]}</p>
                <p class="item-date">{e.period}</p>
              </div>
              <p class="item-meta">
                {e.school[lang]} · {e.detail[lang]}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>{t('cv.certificates')}</h2>
      <ul class="list">
        {
          certificates.map((c) => (
            <li>
              <div class="item-head">
                <p class="item-title">{c.name[lang]}</p>
                <p class="item-date">{c.date}</p>
              </div>
              <p class="item-meta">{c.issuer[lang]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>{t('cv.awards')}</h2>
      <ul class="list">
        {
          awards.map((a) => (
            <li>
              <p class="item-title">{a.name[lang]}</p>
              <p class="item-meta">{a.detail[lang]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>{t('cv.skills')}</h2>
      <dl class="facts">
        {
          skills.map((g) => (
            <>
              <dt>{g.group[lang]}</dt>
              <dd>{g.items.join(', ')}</dd>
            </>
          ))
        }
      </dl>
    </section>
  </div>
</BaseLayout>
