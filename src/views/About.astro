---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { pagePath } from '../i18n/routes';
import { profile, services, club } from '../data/site';
import profilePhoto from '../assets/images/profile.jpeg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const ids = lang === 'tr' ? { services: 'hizmetler', contact: 'iletisim' } : { services: 'services', contact: 'contact' };
const site = 'https://mozdemir.com';

const description =
  lang === 'tr'
    ? 'Muhammet Özdemir hakkında: 3 yılı aşkın yapay zekâ sistemi geliştirme deneyimi, AutoML araştırması ve sunulan hizmetler.'
    : 'About Muhammet Özdemir: 3+ years building AI systems, AutoML research and services offered.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: new URL(pagePath(lang, 'about'), site).href,
  inLanguage: lang === 'tr' ? 'tr-TR' : 'en',
  mainEntity: {
    '@type': 'Person',
    '@id': `${site}/#person`,
    name: profile.name,
    alternateName: profile.alternateName,
    jobTitle: profile.role[lang],
    email: `mailto:${profile.email}`,
    sameAs: [profile.github, profile.linkedin],
  },
};
---

<BaseLayout lang={lang} path={pagePath(lang, 'about')} title={t('about.title')} description={description} current="about" type="profile" jsonLd={jsonLd}>
  <div class="container page">
    <h1>{t('about.title')}</h1>

    <Image
      class="photo"
      src={profilePhoto}
      alt={profile.name}
      widths={[240, 480]}
      sizes="240px"
      loading="eager"
    />

    <div class="prose">
      <p>{profile.bioShort[lang]}</p>
      <p>{profile.bioLong[lang]}</p>
    </div>

    <dl class="facts info">
      {
        profile.facts[lang].map((f) => (
          <>
            <dt>{f.label}</dt>
            <dd>{f.value.includes('@') ? <a href={`mailto:${f.value}`}>{f.value}</a> : f.value}</dd>
          </>
        ))
      }
    </dl>

    <section class="section" id={ids.services}>
      <h2>{t('about.services')}</h2>
      <ul class="list">
        {
          services.map((s) => (
            <li>
              <p class="item-title">{s.title[lang]}</p>
              <p class="item-text muted">{s.text[lang]}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section">
      <h2>{t('about.club')}</h2>
      <p>
        {club.about[lang]} <a href={pagePath(lang, 'club')}>{t('club.title')} →</a>
      </p>
    </section>

    <section class="section" id={ids.contact}>
      <h2>{t('about.contact')}</h2>
      <p>
        {t('about.contact.lead')} <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  :global(.photo) {
    width: 240px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
    border-radius: 8px;
    margin: 24px 0;
  }

  .info {
    margin-top: 24px;
  }
</style>
