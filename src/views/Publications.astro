---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationItem from '../components/PublicationItem.astro';
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';
import { pagePath } from '../i18n/routes';
import { getPublications } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const pubs = await getPublications();

// Yayımlanmış ve süreçteki işler ayrı gruplarda (R19).
const groups: { key: UIKey; items: typeof pubs }[] = [
  { key: 'pubs.group.published', items: pubs.filter((p) => p.data.status === 'published') },
  {
    key: 'pubs.group.under-review',
    items: pubs.filter((p) => p.data.status === 'revision-submitted' || p.data.status === 'under-review'),
  },
  {
    key: 'pubs.group.drafting',
    items: pubs.filter((p) => p.data.status === 'drafting' || p.data.status === 'in-development'),
  },
].filter((g) => g.items.length > 0);

const description =
  lang === 'tr'
    ? 'Genetik programlama ve yapay arı kolonisi ile aktivasyon fonksiyonu tasarımı ve sinir ağı mimari araması üzerine makaleler.'
    : 'Papers on activation-function design and neural architecture search with genetic programming and artificial bee colony methods.';
---

<BaseLayout lang={lang} path={pagePath(lang, 'publications')} title={t('pubs.title')} description={description} current="publications">
  <div class="container page">
    <h1>{t('pubs.title')}</h1>
    {
      groups.map((g) => (
        <section class="section">
          <h2>{t(g.key)}</h2>
          <ul class="list">
            {g.items.map((p) => (
              <PublicationItem lang={lang} pub={p} />
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
