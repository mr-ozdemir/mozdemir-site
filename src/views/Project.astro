---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { pagePath, projectPath } from '../i18n/routes';
import { profile } from '../data/site';
import type { Project } from '../lib/content';

interface Props {
  lang: Lang;
  project: Project;
  prev?: Project;
  next?: Project;
}

const { lang, project, prev, next } = Astro.props;
const t = useTranslations(lang);
const { data } = project;
const { Content } = await render(project);
const path = projectPath(lang, project.slug);
const site = 'https://mozdemir.com';

const facts = [
  ...data.facts,
  ...data.metrics,
  ...(data.stack.length ? [{ label: t('project.stack'), value: data.stack.join(', ') }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: data.title,
  description: data.summary,
  url: new URL(path, site).href,
  inLanguage: lang === 'tr' ? 'tr-TR' : 'en',
  author: { '@type': 'Person', '@id': `${site}/#person`, name: profile.name },
  keywords: data.stack.join(', '),
};
---

<BaseLayout
  lang={lang}
  path={path}
  title={data.title}
  description={data.summary}
  current="projects"
  image={data.cover}
  imageAlt={data.coverAlt}
  type="article"
  jsonLd={jsonLd}
>
  <article class="container page">
    <p class="back small"><a href={pagePath(lang, 'projects')}>← {t('nav.projects')}</a></p>

    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>

    <dl class="facts">
      {
        facts.map((f) => (
          <>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </>
        ))
      }
      {
        data.links.map((l) => (
          <>
            <dt>{t('project.links')}</dt>
            <dd>
              <a href={l.href} target="_blank" rel="noopener">
                {l.label}
              </a>
            </dd>
          </>
        ))
      }
    </dl>

    <figure class="figure cover">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[480, 720, 1440]}
        sizes="(min-width: 760px) 720px, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    {data.note && <p class="note small muted">{data.note}</p>}

    <div class="prose body">
      <Content />
    </div>

    {
      data.gallery.map((f) => (
        <figure class="figure gallery">
          <Image src={f.src} alt={f.alt} widths={[480, 720, 1440]} sizes="(min-width: 760px) 720px, 100vw" />
          {f.caption && <figcaption>{f.caption}</figcaption>}
        </figure>
      ))
    }

    <nav class="pager small" aria-label={lang === 'tr' ? 'Diğer projeler' : 'More projects'}>
      {prev ? <a href={projectPath(lang, prev.slug)} rel="prev">← {prev.data.title}</a> : <span />}
      {next && <a href={projectPath(lang, next.slug)} rel="next">{next.data.title} →</a>}
    </nav>
  </article>
</BaseLayout>

<style>
  .back {
    margin-bottom: 24px;
  }

  .lead {
    margin-top: 12px;
  }

  .facts {
    margin-top: 24px;
  }

  .cover {
    margin-top: 32px;
  }

  .note {
    margin-top: 24px;
  }

  .body {
    margin-top: 32px;
  }

  .gallery {
    margin-top: 32px;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 56px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .pager a:last-child {
    text-align: right;
  }
</style>
